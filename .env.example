# Configuración del meta-agente de aprendizaje.
#
# ESTE ARCHIVO ES OPCIONAL. El compose define un default para cada variable, así que un clon
# recién bajado del repo levanta sin configurar nada. Copiar a `.env` solo para cambiar algo
# (típicamente: la API key del LLM, o la ruta al agente vigilado si no son carpetas hermanas).

# ----- Integración con el agente observado --------------------------------------------
# Ruta EN EL HOST al directorio ./data del agente de seguridad (el que contiene alerts/ y
# traces/). Se monta como /observed en modo SOLO LECTURA.
# En la VPS, con ambos agentes como carpetas hermanas bajo /root/keycloak/:
OBSERVED_DATA_DIR=../agente/data

# Nombre del agente observado: prefija cada entidad (`keycloak-agent:step_latency_s`).
# Cuando se sumen más agentes al esquema, cada uno tendrá su propio identificador.
OBSERVED_AGENT_ID=keycloak-agent

# Nombre de este agente (quién firma las meta-alertas).
META_AGENT_ID=meta-agent

# ----- LLM (opcional) ------------------------------------------------------------------
# Solo se usa en el problem generator, para proponer DÓNDE mirar. Sin API key el agente
# sigue aprendiendo igual, con exploración determinista.
LLM_ENABLED=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=45

# ----- Modelo de normalidad -------------------------------------------------------------
# Observaciones necesarias por dimensión antes de emitir juicios. Bajarlo acelera el
# arranque en frío a costa de una normalidad peor aprendida.
WARMUP=20
# Por encima de este desvío, la observación no se pliega al baseline (no lo contamina).
CLEAN_GUARD_SIGMAS=4.0
# Cuánto se mueve el umbral con cada corrección de la verdad diferida, y sus topes.
THRESHOLD_STEP=0.15
MIN_THRESHOLD=1.5
MAX_THRESHOLD=6.0

# ----- Loop y operación ------------------------------------------------------------------
# Cada cuánto se consultan las trazas cuando no hay eventos nuevos (segundos).
POLL_INTERVAL_SECONDS=2.0
# Ciclos de silencio exigidos entre dos meta-alertas de la misma firma (análisis + dimensión).
DEDUP_COOLDOWN_CYCLES=50
# Cada cuántas escrituras del conocimiento se baja un snapshot a disco.
SAVE_EVERY=200
# Cada cuántos ciclos explora el problem generator (con LLM, es también el gasto de tokens).
EXPLORE_EVERY=200
# Un análisis abierto más tiempo que esto se da por abandonado (el agente observado se colgó).
ABANDON_AFTER_SECONDS=1800
# Ciclos retenidos en la traza auditable en memoria (ventana deslizante).
AUDIT_MAX_RECORDS=5000
# Cada cuántas observaciones se emite el latido en los logs.
HEARTBEAT_CYCLES=500
# Cada cuántos segundos de inactividad se persiste lo aprendido.
IDLE_FLUSH_SECONDS=60

# ----- Exposición del estado (solo lectura) ----------------------------------------------
# Publica por HTTP lo que hasta ahora solo se veía con `--status`: el conocimiento aprendido,
# los hiperparámetros y las últimas meta-alertas. Es lo que consume el dashboard.
#   GET /api/health        latido, entidades vigiladas, análisis abiertos
#   GET /api/config        warmup, guarda de limpieza, paso y topes del umbral
#   GET /api/model         estado por <agente>:<dimensión> (idéntico a `--status`)
#   GET /api/meta-alerts   últimas meta-alertas (?limit=N, tope 2000)
# Apagarlo devuelve al agente a su forma anterior: sin puerto ni superficie de red.
STATE_SERVER_ENABLED=true
STATE_SERVER_PORT=8090
# Lado del HOST. Para no exponerlo a internet y llegar por túnel SSH: 127.0.0.1:8090
STATE_SERVER_PUBLISH=8090
